[Unit]
Description=GPT Toolbox administrator noVNC gateway
After=network.target gpt-vnc-admin.service
Requires=gpt-vnc-admin.service

[Service]
Type=simple
ExecStart=/usr/bin/websockify --web=/usr/share/novnc 127.0.0.1:6081 127.0.0.1:5901
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
