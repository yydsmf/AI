[Unit]
Description=GPT Toolbox collaborator VNC desktop
After=network.target

[Service]
Type=forking
User=gptuser2
Environment=HOME=/home/gptuser2
WorkingDirectory=/home/gptuser2
PIDFile=/home/gptuser2/.vnc/%H:2.pid
ExecStartPre=-/usr/bin/tigervncserver -kill :2
ExecStart=/usr/bin/tigervncserver :2 -localhost yes -SecurityTypes None -geometry 1920x1080 -depth 24
ExecStop=-/usr/bin/tigervncserver -kill :2
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
