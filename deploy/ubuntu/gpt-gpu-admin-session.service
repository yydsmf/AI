[Unit]
Description=GPT Toolbox administrator session on NVIDIA desktop
After=gpt-gpu-desktop.service
Requires=gpt-gpu-desktop.service

[Service]
Type=simple
User=gptadmin
SupplementaryGroups=input
Environment=HOME=/home/gptadmin
Environment=DISPLAY=:0
WorkingDirectory=/home/gptadmin
ExecStart=/usr/local/share/gpt-toolbox/gpt-gpu-admin-session
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
